#!/usr/bin/env sh
# bin/ecl pointed at the throwaway debug daemon (test/debug-daemon.sh up).
# The socket path is hard-coded, so this client cannot reach the user's
# real daemon -- safe to run unattended.
root=$(cd "$(dirname "$0")/.." && pwd)
ECL_SERVER="$root/.debug/socket" exec "$root/bin/ecl" "$@"
